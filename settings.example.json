{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_log.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/detect_significant_event.js" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_escritura.js" }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Agent",
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_cwd_sesion.js" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_kill_por_nombre.js" },
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_revertir_subagente.js" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_decision_prose.js" },
          { "type": "command", "command": "node <PATH_TO_CONFIG>/hooks/check_style.js" }
        ]
      }
    ]
  }
}
